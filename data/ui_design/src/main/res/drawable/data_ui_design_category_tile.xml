<?xml version="1.0" encoding="utf-8"?>
<!-- Genre tile: brand-tinted when selected (the view holder sets isSelected on the root) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/data_ui_design_color_buttons" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/data_ui_design_color_on_surface" />
        </shape>
    </item>
</selector>
