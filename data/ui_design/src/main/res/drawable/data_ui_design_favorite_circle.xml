<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted-glass circle behind the favorite icon on posters and covers:
     translucent dark body, a soft white sheen from the top, and a thin light rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Body -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/data_ui_design_glass_fill" />
        </shape>
    </item>
    <!-- Sheen: light at the top, fading out by the middle -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:centerColor="@android:color/transparent"
                android:endColor="@android:color/transparent"
                android:startColor="@color/data_ui_design_glass_sheen" />
        </shape>
    </item>
    <!-- Rim -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/data_ui_design_glass_rim" />
        </shape>
    </item>
</layer-list>
