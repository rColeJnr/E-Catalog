<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted-glass pill for year / rating / weeks chips over a poster -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="@color/data_ui_design_glass_fill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="270"
                android:centerColor="@android:color/transparent"
                android:endColor="@android:color/transparent"
                android:startColor="@color/data_ui_design_glass_sheen" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <stroke
                android:width="1dp"
                android:color="@color/data_ui_design_glass_rim" />
            <padding android:left="10dp" android:top="3dp" android:right="10dp" android:bottom="3dp" />
        </shape>
    </item>
</layer-list>
