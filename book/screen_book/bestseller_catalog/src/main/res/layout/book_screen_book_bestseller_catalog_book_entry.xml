<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/book_entry_card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical"
    android:layout_margin="@dimen/book_screen_book_bestseller_catalog_six_dp"
    android:backgroundTint="?attr/colorOnSurface"
    android:elevation="@dimen/book_screen_book_bestseller_catalog_six_dp"
    android:transitionName="@string/book_screen_book_bestseller_catalog_transition_name"
    app:cardCornerRadius="@dimen/book_screen_book_bestseller_catalog_twelve_dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:src="@drawable/book_screen_book_bestseller_catalog_ic_fav_outlined"
            app:layout_constraintBottom_toTopOf="@id/title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/book_screen_book_bestseller_catalog_two_dp"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:hint="Movie Title"
            android:layout_marginTop="@dimen/book_screen_book_bestseller_catalog_six_dp"
            android:maxLines="2"
            android:textAlignment="gravity"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
            android:textSize="17sp"
            app:layout_constraintBottom_toTopOf="@id/author"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/author"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:hint="Book Author"
            android:maxLines="2"
            android:textAlignment="gravity"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            app:layout_constraintBottom_toTopOf="@id/show_translation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/quick_actions_overlay"
            android:layout_width="48dp"
            android:layout_height="28dp"
            android:layout_margin="8dp"
            android:alpha="0.8"
            app:cardBackgroundColor="?attr/colorOnSurface"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:layout_constraintStart_toStartOf="@id/image"
            app:layout_constraintTop_toTopOf="@id/image">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/favorite"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/book_screen_book_bestseller_catalog_ic_fav_filled"
                app:tint="@android:color/white" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/show_translation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:insetBottom="0dp"
            android:layout_marginTop="@dimen/book_screen_book_bestseller_catalog_two_dp"
            app:cornerRadius="@dimen/book_screen_book_bestseller_catalog_twelve_dp"
            android:text="@string/book_screen_book_bestseller_catalog_show_translation"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            android:textColor="#27332D"
            android:textStyle="bold"
            app:backgroundTint="?attr/colorSecondary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>