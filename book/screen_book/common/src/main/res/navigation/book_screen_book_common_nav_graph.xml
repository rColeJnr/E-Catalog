<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/book_screen_book_common_nav_graph"
    app:startDestination="@id/book_screen_book_common_webviewfragment">

    <fragment
        android:id="@+id/book_screen_book_common_webviewfragment"
        android:name="com.rick.ecatalogs.book.screen_book.common.WebViewFragment"
        android:label="">
        <deepLink
            android:id="@+id/book_screen_book_common_webviewfragment_deeplink"
            app:uri="com.rick.ecs://book_common_webviewfragment/{link}" />
        <argument
            android:name="link"
            app:argType="string" />
    </fragment>

    <!-- In-app reader for Project Gutenberg books -->
    <fragment
        android:id="@+id/book_screen_book_common_readerfragment"
        android:name="com.rick.ecatalogs.book.screen_book.common.ReaderFragment"
        android:label="">
        <deepLink app:uri="com.rick.ecs://gutenberg_reader/{book}?link={link}&amp;title={title}" />
        <argument
            android:name="book"
            app:argType="integer" />
        <argument
            android:name="link"
            app:argType="string" />
        <argument
            android:name="title"
            android:defaultValue=""
            app:argType="string" />
    </fragment>
</navigation>