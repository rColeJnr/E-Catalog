<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined pill for the age rating (e.g. "PG-13") on the details page -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="6dp" />
    <stroke
        android:width="1.5dp"
        android:color="@color/data_ui_design_text_secondary" />
    <padding
        android:bottom="4dp"
        android:left="10dp"
        android:right="10dp"
        android:top="4dp" />
</shape>
