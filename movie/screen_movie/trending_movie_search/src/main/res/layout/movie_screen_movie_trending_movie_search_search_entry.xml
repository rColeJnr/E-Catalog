<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/movie_entry_card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/data_ui_design_item_entry_margin"
    android:clickable="true"
    android:focusable="true"
    android:transitionName="@string/movie_screen_movie_trending_movie_search_search_transition_name"
    app:cardCornerRadius="@dimen/data_ui_design_background_card_corner_radius"
    app:cardElevation="@dimen/data_ui_design_background_card_elevation">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/data_ui_design_gradient_background"
        android:padding="@dimen/data_ui_design_item_entry_margin">

        <!-- Movie Poster -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/movie_image"
            android:layout_width="0dp"
            android:layout_height="@dimen/data_ui_design_long_image_height"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/DataUiDesignRoundedCorners"
            tools:src="@tools:sample/backgrounds/scenic" />

        <!-- Favorite Button -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/data_ui_design_favorite_button_size"
            android:layout_height="@dimen/data_ui_design_favorite_button_size"
            android:layout_margin="@dimen/data_ui_design_favorite_button_margin"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardElevation="@dimen/data_ui_design_item_card_elevation"
            app:layout_constraintEnd_toEndOf="@id/movie_image"
            app:layout_constraintTop_toTopOf="@id/movie_image"
            app:shapeAppearanceOverlay="@style/DataUiDesignCircleImage">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/favorite"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:padding="@dimen/data_ui_design_favorite_button_padding"
                android:src="@drawable/data_ui_design_favorite_outlined" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Movie Title -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/movie_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/data_ui_design_text_title_h_margin"
            android:layout_marginTop="@dimen/data_ui_design_text_title_v_margin"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/movie_image"
            tools:text="Interstellar" />

        <!-- Movie Summary -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/movie_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/data_ui_design_text_extras_h_margin"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textStyle="italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/movie_name"
            tools:text="A team of explorers travel through a wormhole in space in an attempt to ensure humanity's survival." />

        <!-- Release Year -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/movie_release_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/data_ui_design_text_extras_h_margin"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@android:color/darker_gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/movie_summary"
            tools:text="2014" />

        <!-- Rating (Star Color) -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/movie_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/data_ui_design_text_extras_h_margin"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/movie_release_year"
            app:layout_constraintStart_toEndOf="@id/movie_release_year"
            app:layout_constraintTop_toTopOf="@id/movie_release_year"
            tools:text="★ 8.7" />

        <!-- Translation Action -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/show_translation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/data_ui_design_translate_margin"
            android:text="@string/movie_screen_movie_trending_movie_catalog_show_translation"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@android:color/holo_blue_dark"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/movie_release_year"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/movie_release_year" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
