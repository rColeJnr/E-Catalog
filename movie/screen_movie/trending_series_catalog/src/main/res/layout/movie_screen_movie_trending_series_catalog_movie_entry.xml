<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/movie_entry_card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/data_ui_design_item_entry_margin"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/data_ui_design_background_card_corner_radius"
    app:cardElevation="@dimen/data_ui_design_background_card_elevation">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/data_ui_design_gradient_background"
        android:padding="@dimen/data_ui_design_item_entry_margin">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/movie_image"
            android:layout_width="0dp"
            android:layout_height="@dimen/data_ui_design_wide_image_height"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/DataUiDesignRoundedCorners"
            tools:src="@tools:sample/backgrounds/scenic" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/data_ui_design_favorite_button_size"
            android:layout_height="@dimen/data_ui_design_favorite_button_size"
            android:layout_margin="@dimen/data_ui_design_favorite_button_margin"
            android:elevation="@dimen/data_ui_design_item_card_elevation"
            app:layout_constraintEnd_toEndOf="@id/movie_image"
            app:layout_constraintTop_toTopOf="@id/movie_image"
            app:shapeAppearanceOverlay="@style/DataUiDesignCircleImage">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/favorite"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:padding="@dimen/data_ui_design_favorite_button_padding"
                tools:src="@drawable/data_ui_design_favorite_outlined" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/movie_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/data_ui_design_text_title_h_margin"
            android:layout_marginVertical="@dimen/data_ui_design_text_title_v_margin"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/movie_image"
            tools:text="Series Title" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/movie_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/data_ui_design_text_extras_h_margin"
            android:layout_marginVertical="@dimen/data_ui_design_text_extras_v_margin"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textStyle="italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/movie_name"
            tools:text="This is a summary of the trending TV series that spans multiple lines." />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/movie_release_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/data_ui_design_text_extras_h_margin"
            android:layout_marginVertical="@dimen/data_ui_design_text_extras_h_margin"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@android:color/darker_gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/movie_summary"
            tools:text="2024" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/movie_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/data_ui_design_text_extras_h_margin"
            android:layout_marginVertical="@dimen/data_ui_design_text_extras_v_margin"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/movie_release_year"
            app:layout_constraintStart_toEndOf="@id/movie_release_year"
            app:layout_constraintTop_toTopOf="@id/movie_release_year"
            tools:text="★ 9.2" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/show_translation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/data_ui_design_translate_margin"
            android:padding="2dp"
            android:text="@string/movie_screen_movie_trending_series_catalog_show_translation"
            android:textAppearance="?textAppearanceBody2"
            android:textColor="@android:color/holo_blue_dark"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/movie_release_year"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/movie_release_year" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>