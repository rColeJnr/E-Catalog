<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/data_ui_design_color_surface"
    android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="16dp"
        android:text="Movie Articles"
        android:textAppearance="?attr/textAppearanceHeadline6"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/slogan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="16dp"
        android:text="Explore what the NY Times has to say about new movies"
        android:textAppearance="?attr/textAppearanceBody2"
        android:textColor="@color/data_ui_design_text_secondary" />

    <!-- Catalog list. The content changes weekly, so there is no pull-to-refresh: a thin bar shows
         while the list loads, and the empty / error message can be tapped to try again. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/movie_screen_movie_article_catalog_movie_entry" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/loading_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/data_ui_design_color_buttons"
            app:trackColor="@android:color/transparent" />

        <TextView
            android:id="@+id/empty_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/movie_screen_movie_article_catalog_no_results"
            android:textAppearance="?attr/textAppearanceBody1"
            android:textColor="@color/data_ui_design_text_secondary"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>