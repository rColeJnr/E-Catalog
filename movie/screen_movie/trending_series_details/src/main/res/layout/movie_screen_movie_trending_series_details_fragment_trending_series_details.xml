<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/details_card_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/movie_screen_movie_trending_series_details_gradient_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true"
            android:background="@drawable/movie_screen_movie_trending_series_details_gradient_background"
            android:orientation="vertical"
            android:paddingHorizontal="2dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:layout_gravity="bottom|center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="match_parent"
                        android:layout_height="?attr/actionBarSize"
                        android:layout_marginBottom="@dimen/movie_screen_movie_trending_series_details_six_dp"
                        android:gravity="start|center_vertical"
                        android:hint="@string/movie_screen_movie_trending_series_details_series_name"
                        android:textAlignment="gravity"
                        android:textAppearance="?attr/textAppearanceHeadline6" />

                    <ProgressBar
                        android:id="@+id/details_progress_bar"
                        style="?android:progressBarStyleHorizontal"
                        android:layout_width="282dp"
                        android:layout_height="?attr/actionBarSize"
                        android:indeterminate="true" />

                    <TextView
                        android:id="@+id/details_error_message"
                        android:layout_width="match_parent"
                        android:layout_height="?attr/actionBarSize"
                        android:text="@string/movie_screen_movie_trending_series_details_failed_to_retrieve_data"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="@android:color/holo_blue_light"
                        android:visibility="gone" />

                </LinearLayout>

            </androidx.appcompat.widget.Toolbar>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:elevation="2dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/image"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/movie_screen_movie_trending_series_details_image_height"
                    android:layout_margin="@dimen/movie_screen_movie_trending_series_details_two_dp"
                    app:shapeAppearanceOverlay="@style/MovieScreenMovieCommonRoundedBookCover" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/movie_screen_movie_trending_series_details_overview"
                android:textAppearance="?attr/textAppearanceHeadline5"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/movie_screen_movie_trending_series_details_six_dp"
                android:textAppearance="?attr/textAppearanceBody1"
                tools:text="Set more than a decate after the events of the first film, learn the story of the Sully family, the trouble that follows them" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/show_translation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/movie_screen_movie_trending_series_details_six_dp"
                android:gravity="end|center_vertical"
                android:padding="2dp"
                android:text="@string/movie_screen_movie_trending_series_details_show_translation"
                android:textAlignment="gravity"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textColor="@android:color/holo_blue_dark"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/adult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/movie_screen_movie_trending_series_details_six_dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="@dimen/movie_screen_movie_common_two_dp"
                android:text="@string/movie_screen_movie_trending_series_details_adult_content"
                android:textAppearance="?attr/textAppearanceBody1" />

            <View style="@style/MovieScreenMovieTrendingSeriesDetailsDivider.Horizontal" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/genres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/movie_screen_movie_trending_series_details_six_dp"
                android:layout_marginBottom="@dimen/movie_screen_movie_trending_series_details_two_dp"
                android:text="@string/movie_screen_movie_trending_series_details_genres"
                android:textAppearance="?attr/textAppearanceBody1" />

            <View style="@style/MovieScreenMovieTrendingSeriesDetailsDivider.Horizontal" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/first_air_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/movie_screen_movie_trending_series_details_six_dp"
                android:layout_marginVertical="@dimen/movie_screen_movie_trending_series_details_two_dp"
                android:text="@string/movie_screen_movie_trending_series_details_first_air_date"
                android:textAppearance="?attr/textAppearanceBody1" />

            <View style="@style/MovieScreenMovieTrendingSeriesDetailsDivider.Horizontal" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/in_production"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/movie_screen_movie_trending_series_details_six_dp"
                android:layout_marginVertical="@dimen/movie_screen_movie_trending_series_details_two_dp"
                android:text="@string/movie_screen_movie_trending_series_details_in_production"
                android:textAppearance="?attr/textAppearanceBody1" />

            <View style="@style/MovieScreenMovieTrendingSeriesDetailsDivider.Horizontal" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/last_air_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/movie_screen_movie_trending_series_details_six_dp"
                android:layout_marginVertical="@dimen/movie_screen_movie_trending_series_details_two_dp"
                android:text="@string/movie_screen_movie_trending_series_details_last_air_date"
                android:textAppearance="?attr/textAppearanceBody1" />

            <View style="@style/MovieScreenMovieTrendingSeriesDetailsDivider.Horizontal" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/creator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/movie_screen_movie_trending_series_details_six_dp"
                android:layout_marginVertical="@dimen/movie_screen_movie_trending_series_details_two_dp"
                android:text="@string/movie_screen_movie_trending_series_details_runtime"
                android:textAppearance="?attr/textAppearanceBody1" />

            <View style="@style/MovieScreenMovieTrendingSeriesDetailsDivider.Horizontal" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/number_of_seasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/movie_screen_movie_trending_series_details_six_dp"
                android:layout_marginVertical="@dimen/movie_screen_movie_trending_series_details_two_dp"
                android:text="@string/movie_screen_movie_trending_series_details_number_of_seasons"
                android:textAppearance="?attr/textAppearanceBody1" />

            <View style="@style/MovieScreenMovieTrendingSeriesDetailsDivider.Horizontal" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/number_of_episodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/movie_screen_movie_trending_series_details_six_dp"
                android:layout_marginVertical="@dimen/movie_screen_movie_trending_series_details_two_dp"
                android:text="@string/movie_screen_movie_trending_series_details_number_of_episodes"
                android:textAppearance="?attr/textAppearanceBody1" />

            <View style="@style/MovieScreenMovieTrendingSeriesDetailsDivider.Horizontal" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/ep_runtime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/movie_screen_movie_trending_series_details_six_dp"
                android:layout_marginVertical="@dimen/movie_screen_movie_trending_series_details_two_dp"
                android:text="@string/movie_screen_movie_trending_series_details_runtime"
                android:textAppearance="?attr/textAppearanceBody1" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/movie_screen_movie_trending_series_details_six_dp"
                android:text="@string/movie_screen_movie_trending_series_details_ratings"
                android:textAppearance="?attr/textAppearanceHeadline5"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/movie_screen_movie_trending_series_details_six_dp"
                android:clickable="false"
                android:foregroundGravity="center_horizontal"
                android:layoutDirection="locale"
                android:theme="@style/Theme.MaterialComponents.Light"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/imdb_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#E3C4A8"
                    android:gravity="start"
                    android:text="@string/movie_screen_movie_trending_series_details_imdb_rating"
                    android:textAppearance="?attr/textAppearanceBody2"
                    app:chipBackgroundColor="?attr/colorOnSurfaceVariant"
                    app:chipStrokeColor="@android:color/black"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/movie_db_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#E3C4A8"
                    android:gravity="end"
                    android:text="@string/movie_screen_movie_trending_series_details_db_rating"
                    android:textAppearance="?attr/textAppearanceBody2"
                    app:chipBackgroundColor="?attr/colorOnSurfaceVariant"
                    app:chipStrokeColor="@android:color/black"
                    app:chipStrokeWidth="1dp" />

            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/movie_screen_movie_trending_series_details_six_dp"
                android:text="@string/movie_screen_movie_trending_series_details_similar_titles"
                android:textAppearance="?attr/textAppearanceHeadline5"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_similars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                tools:listitem="@layout/movie_screen_movie_trending_series_details_similar_entry" />
        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.core.widget.NestedScrollView>
