<?xml version="1.0" encoding="utf-8"?>
<!-- Actor screen: photo and facts, biography, and the movies / series they're best known for -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/data_ui_design_gradient_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_marginTop="@dimen/data_ui_design_toolbar_margin_top">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/person_toolbar_name"
                    android:layout_width="@dimen/data_ui_design_toolbar_width"
                    android:layout_height="?attr/actionBarSize"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceHeadline6" />

                <ProgressBar
                    android:id="@+id/person_progress_bar"
                    style="?android:progressBarStyleHorizontal"
                    android:layout_width="@dimen/data_ui_design_toolbar_width"
                    android:layout_height="?attr/actionBarSize"
                    android:indeterminate="true" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- Shown when loading fails; tap to retry -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/person_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:gravity="center"
            android:text="@string/movie_screen_movie_person_details_error"
            android:textAppearance="?attr/textAppearanceBody1"
            android:textColor="@color/data_ui_design_color_buttons"
            android:visibility="gone" />

        <!-- Photo and facts -->
        <LinearLayout
            android:id="@+id/person_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/data_ui_design_text_title_h_margin"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/person_photo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@color/data_ui_design_chip_background"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/DataUiDesignCircleImage"
                tools:src="@tools:sample/avatars" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/person_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceHeadline5"
                    android:textColor="@color/data_ui_design_black"
                    tools:text="Zendaya" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/person_department"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceButton"
                    android:textColor="@color/data_ui_design_color_buttons"
                    tools:text="Acting" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/person_born"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="@color/data_ui_design_text_secondary"
                    tools:text="Born 1 Sept 1996 (age 30)" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/person_died"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="@color/data_ui_design_text_secondary"
                    android:visibility="gone" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/person_place_of_birth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="@color/data_ui_design_text_secondary"
                    tools:text="Oakland, California, USA" />
            </LinearLayout>
        </LinearLayout>

        <!-- Biography (collapsed to a few lines; tap to expand) -->
        <LinearLayout
            android:id="@+id/person_biography_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/data_ui_design_text_title_h_margin"
                android:layout_marginVertical="@dimen/data_ui_design_text_title_v_margin"
                android:text="@string/movie_screen_movie_person_details_biography"
                android:textAppearance="?attr/textAppearanceHeadline6" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/person_biography"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/data_ui_design_text_title_h_margin"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="6"
                android:textAppearance="?attr/textAppearanceBody1"
                android:textColor="@color/data_ui_design_black"
                tools:text="@tools:sample/lorem/random" />

            <!-- Translate (hidden for English) and Read more -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/person_biography_translate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/movie_screen_movie_person_details_show_translation"
                    android:textAppearance="?attr/textAppearanceButton"
                    android:textColor="@color/data_ui_design_color_buttons"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/person_biography_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/movie_screen_movie_person_details_read_more"
                    android:textAppearance="?attr/textAppearanceButton"
                    android:textColor="@color/data_ui_design_color_buttons" />
            </LinearLayout>
        </LinearLayout>

        <!-- Known for -->
        <LinearLayout
            android:id="@+id/person_credits_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/data_ui_design_text_title_h_margin"
                android:layout_marginVertical="@dimen/data_ui_design_text_title_v_margin"
                android:text="@string/movie_screen_movie_person_details_known_for"
                android:textAppearance="?attr/textAppearanceHeadline6" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/person_credits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="3"
                tools:listitem="@layout/movie_screen_movie_person_details_credit_entry" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
